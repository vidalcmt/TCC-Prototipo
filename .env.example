# Copie este arquivo para .env e preencha a chave.
# O .env está no .gitignore e nunca deve ir para o GitHub.

OPENAI_API_KEY=sk-coloque-sua-chave-aqui

# Modelo fixado para toda a pesquisa. Trocar exige registrar no artigo.
MODELO=gpt-6.1-sol

# Banco: por padrão, o arquivo tcc.db na raiz do projeto, qualquer que seja a
# pasta de onde o comando for rodado. Só defina DATABASE_URL para usar outro
# banco, e sempre com caminho absoluto.
