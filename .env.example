# Copie este arquivo para .env e preencha a chave.
# O .env está no .gitignore e nunca deve ir para o GitHub.

OPENAI_API_KEY=sk-coloque-sua-chave-aqui

# Modelo fixado para toda a pesquisa. Trocar exige registrar no artigo.
MODELO=gpt-6.1-sol

# Banco: por padrão, o arquivo tcc.db na raiz do projeto, qualquer que seja a
# pasta de onde o comando for rodado. Só defina DATABASE_URL para usar outro
# banco, e sempre com caminho absoluto.

# Chave que assina o cookie de login. Gere uma vez e não compartilhe:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Sem ela, o sistema usa uma chave temporária e todos saem a cada reinício.
SECRET_KEY=

# Ligue (true) só quando o site estiver em HTTPS, no servidor.
COOKIE_SEGURO=false

# Máximo de chamadas ao modelo por pessoa por dia (dia de Brasília).
LIMITE_CHAMADAS_DIA=60
# Uma turma de 40 alunos com 2 discursivas são 80 chamadas: para corrigir a
# turma toda num dia, aumente este valor.

# Pasta das folhas digitalizadas. Por padrão, a pasta arquivos na raiz do
# projeto. Só defina para usar outro lugar, com caminho absoluto.
# PASTA_ARQUIVOS=
